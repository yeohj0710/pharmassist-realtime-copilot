{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharmassist.local/schemas/runtime_output.schema.json",
  "title": "RuntimeOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "session_id",
    "sequence",
    "mode",
    "status",
    "intent",
    "say_now",
    "ask_next",
    "red_flags",
    "actions",
    "avoid",
    "missing_slots",
    "confidence",
    "decision",
    "topic_results",
    "source_refs",
    "latency",
    "knowledge_version",
    "generated_at"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer"
    },
    "mode": {
      "type": "string",
      "enum": [
        "instant",
        "refined",
        "escalate",
        "clarify",
        "no_match"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "provisional",
        "stable",
        "blocked",
        "final"
      ]
    },
    "intent": {
      "type": [
        "string",
        "null"
      ]
    },
    "say_now": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "maxLength": 180
      }
    },
    "ask_next": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "reason",
          "priority",
          "slot"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "slot": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "maxItems": 8,
            "description": "Pack-defined answer branches for this question. key is the select-rule id; phrases are the rule's own match wordings, given to the interpreter as the meaning of each branch.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "phrases"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_.-]{1,127}$"
                },
                "phrases": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "string",
                    "maxLength": 80
                  }
                }
              }
            }
          }
        }
      }
    },
    "red_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "flag_id",
          "label",
          "action",
          "matched"
        ],
        "properties": {
          "flag_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "emergency",
              "same_day",
              "doctor",
              "stop_and_verify"
            ]
          },
          "matched": {
            "type": "boolean"
          },
          "negated": {
            "type": "boolean"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "text",
          "requires_confirmation"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "requires_confirmation": {
            "type": "boolean"
          }
        }
      }
    },
    "avoid": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_slots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "candidate_intents": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intent",
          "score"
        ],
        "properties": {
          "intent": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "source_id",
          "source_snapshot_id",
          "locator",
          "verified_at"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_snapshot_id": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_ms",
        "normalize_ms",
        "safety_ms",
        "retrieve_ms",
        "refine_ms"
      ],
      "properties": {
        "total_ms": {
          "type": "number",
          "minimum": 0
        },
        "normalize_ms": {
          "type": "number",
          "minimum": 0
        },
        "safety_ms": {
          "type": "number",
          "minimum": 0
        },
        "retrieve_ms": {
          "type": "number",
          "minimum": 0
        },
        "refine_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "knowledge_version": {
      "type": "string"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "stale_response_dropped": {
      "type": "boolean"
    },
    "decision": {
      "$ref": "recommendation_decision.schema.json"
    },
    "topic_results": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol_id",
          "intent",
          "symptom_category",
          "decision",
          "ask_next"
        ],
        "properties": {
          "protocol_id": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "symptom_category": {
            "type": "string"
          },
          "decision": {
            "$ref": "recommendation_decision.schema.json"
          },
          "ask_next": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "question",
                "reason",
                "priority",
                "slot"
              ],
              "properties": {
                "question": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "priority": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "slot": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "fact_targets": {
      "type": "array",
      "maxItems": 4,
      "description": "Every branch slot the active protocol can act on this turn — the open question's and the upcoming ones — with its pack-defined options. The interpreter listens for all of them at once, so one customer sentence can settle several.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "question",
          "options"
        ],
        "properties": {
          "slot": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "phrases"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_.-]{1,127}$"
                },
                "phrases": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "string",
                    "maxLength": 80
                  }
                }
              }
            }
          }
        }
      }
    },
    "provisional_candidates": {
      "$ref": "recommendation_decision.schema.json#/properties/product_candidates",
      "description": "Best-so-far products for the pharmacist to see while the decision is still waiting on an answer. Display only: the decision itself is untouched, so the engine's ask-twice-then-fall-back retry keeps working. Empty on a referral or an escalation, where no product may be shown at all."
    }
  }
}
